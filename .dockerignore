# Only image inputs, including the MCP security resource, enter the context.
**
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!docker-entrypoint.sh
!scripts/
!scripts/normalize_venv_metadata.py
!src/
!src/**
!docs/

# Python
.venv
__pycache__
*.py[oc]
build
dist
wheels
*.egg-info

# Git / IDE / OS
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.DS_Store
*.swp

# Python tool caches
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Local config (NEVER bake secrets into the image)
.env
.env.*
!.env.example
*.pem
*.key
secrets/
logs/
.cache/

# Tests + tooling output (image is for runtime, not test)
tests
.bandit
.bandit-report.*.json

# Positronic project metadata
.positronic
AGENTS.md
# Repository documentation is not a runtime input. The security policy the
# server serves travels inside the wheel
# (``src/percival_osm_mcp/docs/security/nanobot-policy.md``, already allowed
# by ``!src/**`` above), so nothing under the repository's ``docs/`` belongs
# in the build context. The directory itself is kept only because the
# Dockerfile copies it into the build stage.
docs/**

# Docker-specific — the catalog entry lives outside the image build
servers
docker-compose.yml
docker-compose.*.yml

# Markdown
*.md
!README.md

# GitHub metadata that may have been copied
.editorconfig
.prettierignore
.eslintrc*

# Apply the state/secret boundary inside copied source trees too.
**/.venv/
**/.positronic/
**/.env
**/.env.*
**/secrets/
**/*.pem
**/*.key
**/__pycache__/
**/.cache/
**/AGENTS.md
**/.pytest_cache/
**/node_modules/
**/tests/
